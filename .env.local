# Local development / deployment environment.
#
# Required: a PostgreSQL connection string. For local dev and for the
# hosted (Render) backend, use the SAME Neon connection string so both
# read/write the same data — see server/README-local.md.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# Optional overrides (defaults shown):
# WGATE_API_PORT=4400
# WGATE_API_HOST=0.0.0.0
