{
  "name": "wgate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/wgate-server.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "server": "node server/wgate-server.mjs",
    "preview": "vite preview",
    "build:ghpages": "vite build",
    "build:android": "cross-env VITE_API_URL=https://wgate-fixed.onrender.com/api vite build && node -e \"require('node:fs').rmSync('dist/wgate.apk',{force:true})\" && npx cap sync android",
    "deploy": "npm run build:ghpages && gh-pages -d dist"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
